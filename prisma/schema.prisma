generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  stock       Int      @default(0)
  price       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}